# Audio generado por ElevenLabs (se regenera solo; nunca al repositorio)
wj-content/cache/audio/*
!wj-content/cache/audio/.gitkeep

# Contadores del limitador de peticiones.
# El directorio SÍ se versiona (con su .gitkeep) y su contenido no: es el mismo
# trato que wj-content/cache/audio. Un «wj-content/cache/limites/» a secas excluía la carpeta entera,
# así que en un despliegue por FTP no llegaba y había que acordarse de crearla a
# mano. Aquí el olvido es caro: sin poder escribir los contadores, los topes de
# gasto por IP no se aplican y nadie se entera hasta que llega la factura.
wj-content/cache/limites/*
!wj-content/cache/limites/.gitkeep

# Tablas de JPL Horizons: una por cuerpo y día, se rehacen solas
wj-content/cache/efemerides/*
!wj-content/cache/efemerides/.gitkeep

# Respuestas del asistente, guardadas solo para poder decirlas en voz alta
wj-content/cache/respuestas/*
!wj-content/cache/respuestas/.gitkeep

# Registros del backend
wj-content/logs/*
!wj-content/logs/.gitkeep
!wj-content/logs/.htaccess

# Claves reales: solo se versiona la plantilla wj-config-ejemplo.php
wj-config.php

# Lo que se guarda desde el panel de wj-admin: lleva claves de API. El
# directorio SÍ viaja, para que exista y sea escribible tras un «git pull»;
# su contenido, nunca.
wj-content/ajustes/*
!wj-content/ajustes/.gitkeep
!wj-content/ajustes/.htaccess

# Lo que se añade o corrige desde la pestaña de conocimiento del panel. Mismo
# trato: la carpeta viaja, su contenido no. Si se versionara, el siguiente
# «git pull» de Plesk chocaría con lo que se haya editado en el servidor.
wj-content/conocimiento/*
!wj-content/conocimiento/.gitkeep
!wj-content/conocimiento/.htaccess

# Las texturas SÍ se versionan: 13 MB que permiten desplegar en Plesk con un
# solo «git pull», sin subir nada aparte. Licencias en CREDITOS.json.
# Se descargan y actualizan con: node tools/texturas.mjs
wj-content/assets/skybox/*
!wj-content/assets/skybox/.gitkeep

# Respuestas crudas de JPL Horizons: caché local de tools/datos-jpl.mjs
.cache-horizons/

# El modelo de MediaPipe SÍ se versiona (7,6 MB): así el despliegue en Plesk
# es un único «git pull» y no hay que acordarse de subirlo por FTP aparte, que
# es exactamente el fallo que dejó la primera versión sin funcionar.
# Se descarga y actualiza con: node tools/vendor.mjs mediapipe

# El grafo de Graphify (/graphify): se regenera con «graphify update .» y se
# queda viejo en cuanto cambia el código. Versionarlo sería guardar una foto.
graphify-out/

# Copias de trabajo aisladas que crea el asistente de desarrollo para tareas en
# paralelo. Son ramas de git completas: meterlas en un commit duplicaría el
# repositorio dentro de sí mismo.
.claude/worktrees/

# Sistema operativo / editores
.DS_Store
Thumbs.db
*.swp
node_modules/

# Caché de Python de la skill vendorizada
__pycache__/
*.pyc
