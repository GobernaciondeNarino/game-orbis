# ============================================================================
#  ORBIS — Interfaz holográfica del Sistema Solar
#  Configuración de Apache para hosting Plesk (PHP 8.1+, sin Node.js).
#
#  ORGANIZACIÓN
#    wj-includes/  el motor: PHP, JS, CSS y librerías de terceros.
#    wj-content/   lo que el sitio tiene y genera: datos, medios, caché, logs.
#    wj-admin/     el panel de configuración.
#    raíz          index.html y wj-config.php, y nada más.
# ============================================================================

Options -Indexes
# index.php al final: lo necesita /wj-admin/, que es lo único con PHP servido
# como página. El resto del sitio sigue siendo index.html estático.
DirectoryIndex index.html index.php

# Redirige «…/orbis» a «…/orbis/». Sin la barra final, el navegador resolvería
# wj-includes/ y wj-content/ contra el directorio padre y todo devolvería 404.
# Es el comportamiento por omisión de Apache, pero se deja explícito porque de
# él depende que la aplicación funcione en un subdirectorio.
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# ---------------------------------------------------------------------------
# 1. HTTPS obligatorio
#    getUserMedia() (cámara y micrófono) solo funciona en contextos seguros.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Plesk puede terminar TLS en el proxy: aceptamos también X-Forwarded-Proto.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# 2. Tipos MIME
#    Apache no conoce .task, .wasm ni .mjs de serie: sin esto el navegador
#    rechaza los módulos ES y MediaPipe no arranca.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript            .js .mjs
  AddType application/json                  .json
  AddType application/wasm                  .wasm
  AddType application/octet-stream          .task
  AddType model/gltf-binary                 .glb
  AddType model/gltf+json                   .gltf
  AddType font/woff2                        .woff2
  AddType image/ktx2                        .ktx2
  AddType image/webp                        .webp
  AddType image/avif                        .avif
  AddType audio/mpeg                        .mp3
  AddType image/svg+xml                     .svg

  AddCharset UTF-8 .js .mjs .css .json .html .svg
</IfModule>

# ---------------------------------------------------------------------------
# 3. Compresión
#    Determinante en conexiones lentas: three.module.min.js pasa de ~356 kB
#    a ~90 kB con Brotli. Los .woff2, .mp3, .webp y .wasm ya vienen comprimidos.
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain \
      application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
      application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 4. Caché
#    - wj-includes/externos/ y wj-content/assets/: inmutables durante un año.
#    - js/, css/ y data/: revalidación obligatoria, para poder desplegar
#      correcciones sin pedir al usuario que vacíe la caché.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(woff2|jpg|jpeg|png|webp|avif|ktx2|glb|gltf|task|wasm|mp3|ogg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# wj-includes/externos/ son copias con versión fijada de Three.js y MediaPipe:
# nunca cambian sin cambiar de ruta. El patrón no lleva ancla inicial para que
# funcione también en un subdirectorio (…/juegos/orbis/wj-includes/externos/…).
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/wj-includes/externos/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# ---------------------------------------------------------------------------
# 5. Cabeceras de seguridad y de permisos de dispositivo
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # La cámara y el micrófono solo puede pedirlos esta misma página.
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains" env=HTTPS

  # CSP: todo se sirve desde este origen. 'wasm-unsafe-eval' y blob: son
  # imprescindibles para el WASM y el worker de MediaPipe.
  # El hash corresponde al <script type="importmap"> de index.html; si se
  # modifica ese bloque hay que regenerarlo con:  node tools/csp-hash.mjs
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: 'sha256-LazbYOg/UPr5ZnMItKyhIRL4Ldh0IdTtMS781fiC3+g='; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# ---------------------------------------------------------------------------
# 6. Rutas privadas
#
#    De wj-includes solo se sirve lo que el navegador pide de verdad: js/, css/,
#    externos/ y los endpoints de api/. Las clases PHP (lib/) y las
#    dependencias de Composer (vendor/) se INCLUYEN desde el servidor, nunca se
#    piden por URL; sin esto, los más de dos mil .php del SDK se podían
#    enumerar, y enumerarlos revela la versión exacta de cada librería.
#
#    De wj-content solo se sirven data/ y assets/. La caché guarda audio ya
#    pagado y respuestas del asistente, y los registros pueden llevar detalles
#    de errores: ninguna de las dos cosas se publica.
#
#    Cada una de estas carpetas lleva además su propio .htaccess. Esto es la
#    segunda cerradura, por si el hosting no honra los de subdirectorio.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^wj-includes/(lib|vendor)/ - [F,L]
  RewriteRule ^wj-content/(cache|logs|ajustes)/ - [F,L]
  RewriteRule ^(tools|docs/borradores)/ - [F,L]
  # Herramientas del asistente de desarrollo, no del sitio. .claude/ trae las
  # skills vendorizadas —scripts, datos y su configuración— y graphify-out/ es
  # el mapa completo del código que genera Graphify: todo eso viajaba con el
  # «git pull» y se podía descargar por su ruta.
  RewriteRule ^(\.claude|\.git|graphify-out)(/|$) - [F,L]
</IfModule>

# wj-config.php son LAS CLAVES. Se deniega por nombre, esté donde esté: en la
# raíz no hay una carpeta que aislar, así que la cerradura es esta.
<FilesMatch "^wj-config(-ejemplo)?\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "^(\.htaccess|\.gitignore|\.env|composer\.(json|lock)|package(-lock)?\.json|.*\.md)$">
  Require all denied
</FilesMatch>
